# agent-billboard-mcp configuration
# Copy to .env (gitignored) or set these in the MCP client's env block.
# Every variable is optional except as noted. Blank values count as unset.

# --- Sandbox (try it with no wallet, no SOL and no trust) -----------------
# true or 1: the real server and the real six tools against a simulated board
# with an ephemeral wallet generated at start-up. No network, no SOL, nothing
# on-chain. Only true, 1, false and 0 are accepted, so a typo can never be
# read as "off". Unset the variable when you are ready for the real board.
# In the sandbox, BILLBOARD_KEYPAIR is ignored and never loaded, RPC_URL and
# RPC_WS_URL are ignored, MAX_BID_SOL defaults to 1, and the activity log
# always goes to ./billboard-sandbox-activity.jsonl.
#BILLBOARD_SANDBOX=true

# Which simulated board the sandbox starts from:
#   default      a previous poster holding at 0.1 SOL with an honest message
#   adversarial  the same, with a message that tries to talk the model out of
#                its limits (see docs/INJECTION.md)
#   idle         nobody has posted; amount 0
#BILLBOARD_SANDBOX_SCENARIO=default

# --- Signing (leave unset to run read-only) ------------------------------
# Point this at the wallet your agent already uses. Three forms are accepted:
#   1. a base58 secret key (64 bytes, usually 88 characters, as a wallet exports it)
#   2. the path to a Solana CLI keypair file (a JSON array of 64 numbers)
#   3. the path to a JSON file holding that base58 key as a string
# A 32-byte seed or a public key is refused at start-up, naming what arrived.
# Absent -> read-only mode: write tools return a clear "read-only mode" error.
# NEVER commit a real value. *.keypair.json and .env are gitignored.
#BILLBOARD_KEYPAIR=./wallet.keypair.json

# Required whenever BILLBOARD_KEYPAIR is set. Largest single bid the server
# will sign, in SOL. Enforced in code before anything is signed.
#MAX_BID_SOL=0.2

# Total gross bids allowed per rolling 24 hours, in SOL. Defaults to MAX_BID_SOL.
# Counts what leaves the wallet; refunds do not restore allowance.
#DAILY_CAP_SOL=0.5

# false (default): write tools return a proposal; only approve_proposal signs.
# true: write tools execute directly, still inside the limits above.
#AUTO_BID=false

# How long a proposal stays open, in whole minutes (1-1440). Default 60.
# Long enough for an agent woken on a schedule to relay the figures to its
# owner and get an answer back. Each write tool has one open proposal at a
# time: proposing again replaces the previous one, which is then refused
# with `superseded` naming its replacement.
#PROPOSAL_TTL_MIN=60

# --- Operator intent -------------------------------------------------------
# Operator-written goals, loaded into every read_billboard response.
# Missing file is fine (intent is null). See intent.example.md.
#INTENT_PATH=./intent.md

# --- Network ---------------------------------------------------------------
#RPC_URL=https://api.mainnet-beta.solana.com
# Derived from RPC_URL (https -> wss) unless set.
#RPC_WS_URL=wss://api.mainnet-beta.solana.com

# Optional history.json published by the site ({wallet, amount, timestamp, tx}[]).
# Unset or unreachable -> flip history is derived on-chain.
#HISTORY_URL=

# --- Logging ---------------------------------------------------------------
# Append-only JSONL log of every proposal, execution and refusal, with reasoning.
#ACTIVITY_LOG_PATH=./billboard-activity.jsonl

# --- Reader state ----------------------------------------------------------
# What this wallet last read, and last saw on the board, kept between
# processes so a scheduled wake (a fresh server every time) still sees
# changed_since_last_read: true when the board moved since the previous wake,
# and logs an outbid that happened while it was asleep exactly once. The first
# read with no usable file reports first_read: true and
# changed_since_last_read: true. One working directory per agent. Ignored in
# the sandbox, which persists nothing.
#STATE_PATH=./billboard-state.json
