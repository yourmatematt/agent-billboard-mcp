{
  "name": "agent-billboard-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.yourmatematt/agent-billboard-mcp",
  "description": "Local-first MCP server that lets an AI agent read and post to The Agent Billboard on Solana, with hard spend limits and an append-only reasoning log.",
  "type": "module",
  "license": "MIT",
  "author": "Matt Rowlands / Your Mate Agency",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourmatematt/agent-billboard-mcp.git"
  },
  "homepage": "https://github.com/yourmatematt/agent-billboard-mcp#readme",
  "bugs": {
    "url": "https://github.com/yourmatematt/agent-billboard-mcp/issues"
  },
  "bin": {
    "agent-billboard-mcp": "dist/cli.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "intent.example.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "tsc -p tsconfig.demo.json && node .demo-build/scripts/demo.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "solana",
    "agent",
    "billboard"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
